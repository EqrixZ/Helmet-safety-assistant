# ---------------------------------------------------------------
# Helmet Safety Assistant — ตัวอย่างไฟล์ตั้งค่า (คัดลอกเป็น .env)
# ใช้ endpoint ที่เข้ากันได้กับ OpenAI API ได้ทุกเจ้า — เลือกเปิดใช้ 1 ชุด
# ---------------------------------------------------------------

# --- 1) OpenAI ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- 2) Typhoon (SCB 10X) ---
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.opentyphoon.ai/v1
# LLM_MODEL=typhoon-v2.1-12b-instruct

# --- 3) Google Gemini (OpenAI-compatible endpoint) ---
# LLM_API_KEY=AQ....
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.8-flash

# --- 4) Ollama (local; ใส่ API key อะไรก็ได้ที่ไม่ว่าง) ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1      # ใน docker ใช้ http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:7b

# --- การจำกัดอัตราเรียกใช้ (rate limit) ---
# จำนวนคำขอสูงสุดต่อนาทีต่อผู้ให้บริการ (ใช้กับแชท รายงาน และการประเมิน) — 0 = ไม่จำกัด
# Gemini free tier จำกัด 5 คำขอ/นาที จึงตั้ง 4 ไว้เผื่อ
LLM_RPM=4
# คำขอที่ได้ 429/503 จะถูกลองใหม่อัตโนมัติสูงสุด 5 ครั้ง (รอ 2, 4, 8, 16 วินาที หรือตาม Retry-After)

# --- ผู้ให้บริการสำรอง (ไม่บังคับ) ---
# ถ้าตั้งครบทั้ง 3 ค่า เมื่อผู้ให้บริการหลักยังล้มเหลวหลังลองใหม่ครบ ระบบจะสลับไปใช้ตัวสำรอง
# (และข้ามตัวหลัก 60 วินาทีก่อนกลับมาลองใหม่) เช่น Typhoon หรือ Ollama ในเครื่อง
# LLM_FALLBACK_API_KEY=ollama
# LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
# LLM_FALLBACK_MODEL=qwen2.5:7b

# ---------------------------------------------------------------
# การตรวจจับ (Detector)
# ---------------------------------------------------------------
# threshold ของคลาส Helmet (และค่าพื้นฐาน)
CONF_THRESHOLD=0.35
# threshold ของคลาส Head (ไม่สวมหมวก) — สูงกว่าเพื่อลด false violation จากวิดีโอที่ถูกบีบอัด
HEAD_CONF_THRESHOLD=0.55
# คลิปจะถูกนับเป็นการละเมิดเมื่อพบ Head >= 1 ในอย่างน้อยสัดส่วนนี้ของเฟรมที่สุ่ม (0–1)
VIOLATION_FRAME_RATIO=0.4

# ---------------------------------------------------------------
# อื่น ๆ
# ---------------------------------------------------------------
SITE_NAME=โครงการก่อสร้างอาคาร A
# DATA_DIR=./data
